{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["arn1"],
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/health", "destination": "/api/mcp?route=health" }
  ],
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60,
      "includeFiles": "data/scb-catalog/**"
    }
  }
}
