SCB_BASE_URL=https://privateapi.scb.se/nv0101/v1/sokpavar
SCB_API_ID=API-ID
SCB_CERT_PATH="Path/to/certificate.pfx"
SCB_CERT_PASSWORD=Password
SCB_LOG_LEVEL=info
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Delad hemlighet för MCP HTTP/SSE (/sse och /messages).
# Rekommenderas även på localhost. Obligatorisk när MCP_HOST inte är loopback (t.ex. 0.0.0.0).
# Generera: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MCP_AUTH_TOKEN=
# Valfritt. Standard: api-id
# SCB_API_ID_HEADER=api-id
