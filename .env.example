SCB_BASE_URL=https://privateapi.scb.se/nv0101/v1/sokpavar
SCB_API_ID=API-ID
SCB_CERT_PATH="Path/to/certificate.pfx"
SCB_CERT_PASSWORD=Password
SCB_LOG_LEVEL=info
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Shared secret for MCP HTTP/SSE (/sse and /messages).
# Recommended even on localhost. Required when MCP_HOST is not loopback (e.g. 0.0.0.0).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MCP_AUTH_TOKEN=
# Optional. Default: api-id
# SCB_API_ID_HEADER=api-id
