SCB_BASE_URL=https://privateapi.scb.se/nv0101/v1/sokpavar
SCB_API_ID=API-ID
SCB_CERT_PATH="Path/to/certificate.pfx"
# Cloud Run: base64 of the .pfx instead of a file path. Do not set both unless the path exists.
# SCB_CERT_BASE64=
SCB_CERT_PASSWORD=Password
SCB_LOG_LEVEL=info
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Cloud Run sets PORT (usually 8080). When PORT is set and MCP_HOST is unset, the server binds 0.0.0.0.
# PORT=
# Delad hemlighet för MCP HTTP (/mcp, /sse, /messages).
# Rekommenderas även på localhost. Obligatorisk när MCP_HOST inte är loopback (t.ex. 0.0.0.0).
# Generera: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MCP_AUTH_TOKEN=
# Custom header name besides Authorization. Default x-mcp-auth (header X-MCP-Auth).
# MCP_AUTH_HEADER=x-mcp-auth
# Comma-separated tool allowlist, or the preset "voice"
# (scb_find_company and company_website_summary). Unset = all tools.
# MCP_EXPOSED_TOOLS=voice
# Tavily Search API key. Required for company_website_summary when url is omitted.
# TAVILY_API_KEY=
# Optional. When set, company_website_summary asks gpt-4o-mini for the Swedish summary.
# Without it, the tool returns extracted sentences and does not call a model.
# OPENAI_API_KEY=
# Valfritt. Standard: api-id
# SCB_API_ID_HEADER=api-id
# Firestore company index for scb_find_company (project bizmate-ai-specialist, collection companies).
# Full service-account JSON, one line. Role: Cloud Datastore User. Never commit the value.
# GCP_SA_JSON=
# Optional. When set, Vercel Cron sends Authorization: Bearer <CRON_SECRET>
# and GET /api/warm requires it. When unset, /api/warm is open.
# CRON_SECRET=
# Hoppa över processcachen för metadata (live-kontroller). Standard: cache i flera timmar.
# SCB_METADATA_CACHE_BYPASS=true
# AE Arbetsställestatus som toppnivåfält. Default true tills /help/exampleAe bekräftas live (cert).
# Ändra inte defaulten utan evidens. Om exampleAe visar Kategorier[]: false och starta om.
# SCB_AE_STATUS_TOP_LEVEL=true
